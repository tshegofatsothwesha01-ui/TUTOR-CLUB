# Copy this to .env locally and fill values (do NOT commit real secrets)

# Demo: leave as 1 for local testing
DEMO_MODE=1

# Admin credentials (use a secure long password for production)
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters

# Public URL used for payment callbacks; must be HTTPS for real PayFast
PUBLIC_BASE_URL=https://your-public-domain.example

# Cookie Secure: set to 1 in production
COOKIE_SECURE=1

# Where SQLite will be stored (when containerized use /var/data)
TUTOR_CLUB_DATA_DIR=/var/data

# PayFast (sandbox first)
PAYFAST_SANDBOX=1
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
